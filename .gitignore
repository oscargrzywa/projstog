# Root .gitignore — obowiązuje w całym repo (projstog_2.0).
# Podprojekty mogą mieć własne .gitignore (np. old_projstog/my-app/.gitignore).

# zależności
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build / cache
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# testy
coverage/

# sekrety — NIGDY nie commitować
.env
.env.*
!.env.example
*.pem

# hosting
.vercel

# artefakty narzędzi agentowych (zrzuty stron, logi konsoli)
.playwright-mcp/

# logi debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# system
.DS_Store
Thumbs.db
